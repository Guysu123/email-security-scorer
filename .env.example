# Vercel / local backend environment variables
# Copy to .env.local for local development — never commit .env.local

# Pre-shared secret between the Gmail Add-on and the backend
# Generate with: openssl rand -hex 32
ADDON_API_SECRET=your_secret_here

# Anthropic API key for BECLinguisticScanner Stage 2 analysis
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override log level (debug | info | warn | error)
LOG_LEVEL=info
