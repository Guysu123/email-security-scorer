{
  "outputDirectory": ".",
  "buildCommand": "",
  "functions": {
    "api/analyze.ts": {
      "maxDuration": 30
    },
    "api/health.ts": {
      "maxDuration": 5
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
